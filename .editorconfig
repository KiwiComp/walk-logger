root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ktlint settings live in build.gradle.kts; these keep Android Studio's formatter in line with them.
[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 100
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
